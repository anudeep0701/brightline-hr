# Documentation only: keep placeholders blank. Never commit real credentials.
# npm run dev loads root .env, then .env.local; nonempty exported variables win.
# One-command setup and SQLite/PostgreSQL examples: docs/LOCAL_DEVELOPMENT.md

# Required for backend startup. Use a development PostgreSQL connection URI.
# Existing local SQLite demo syntax (relative to repository root):
#   sqlite:///./data/demo-v4.db
# Seed that demo once with scripts/seed.py before launching the app.
DATABASE_URL=

# Optional, backend-only. Monitoring and deterministic explanations work without AI.
OPENAI_API_KEY=

# Optional, backend-only model override. Default: gpt-6-luna.
OPENAI_MODEL=

# Required only for production settings/scheduler authorization; unused by local launcher.
CRON_SECRET=

# Local default: demo. Supported local values: demo or test. Production requires PostgreSQL.
APP_ENV=

# Local default: http://localhost:3000. Optional exact cross-origin browser origins.
# Leave unset in same-origin production; no production CORS grants are needed.
CORS_ALLOWED_ORIGINS=

# Optional local override; local default: http://localhost:8000.
# Leave unset in production to use the current app origin for /api/*.
# Public URL only; never put secrets here.
NEXT_PUBLIC_API_BASE_URL=

# Required only when running local PostgreSQL through Docker Compose.
PGPASSWORD=

# Optional hosted assessment only; default false. Explicitly set true to enable.
DEMO_MODE=
# Required when DEMO_MODE=true. Existing synthetic tenant ID; no browser selection.
DEMO_TENANT_SLUG=
# Backend-only independent random signing secret (32+ characters), required in demo mode.
DEMO_SESSION_SECRET=
# Optional public assessment capability; default false. Requires DEMO_MODE=true.
DEMO_ALLOW_FILE_IMPORT=
